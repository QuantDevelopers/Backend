# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# App / Server
APP_NAME=QuantBackend
APP_HOST=0.0.0.0
APP_PORT=8000
SERVER_MODE=development
DEBUG=true
ROOT_PATH=

# Logger & Rate Limiting
LOG_LEVEL=debug
LOG_FILE=
CONSOLE_OUTPUT=true
RATE_LIMIT=60
RATE_LIMIT_BURST=120

# Pagination Defaults
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=25

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quant_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# PostgreSQL Connection URL (GORM / pgx)
# Used inside Docker:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/quant_db?sslmode=disable
# For running locally outside Docker without container networking:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quant_db?sslmode=disable

# Database Connection Pool Settings
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Origins (allow frontend access, comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Crawler Settings
CRAWLER_RATE_LIMIT_RPS=3.0
CRAWLER_MAX_RETRIES=5
CRAWLER_BACKOFF_FACTOR=1.5
CRAWLER_RAW_DATA_PATH=./data/raw
